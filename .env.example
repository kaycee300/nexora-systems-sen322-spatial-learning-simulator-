SKILLSCAPE_SECRET=change-me-for-local-dev

# SMTP email delivery for signup verification codes.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
FROM_EMAIL=no-reply@skillscape.local
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT=10

# Set to true only when FastAPI is behind a trusted reverse proxy.
TRUST_PROXY_HEADERS=false
